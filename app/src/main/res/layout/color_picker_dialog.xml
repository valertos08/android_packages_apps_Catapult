<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="350dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:id="@+id/color_preview"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/color_picker_preview_bg" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/color_picker_presets"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/presets_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:focusable="false" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/color_picker_custom"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R:"
            android:textColor="?attr/colorOnSurface"
            android:layout_gravity="center_vertical" />

        <SeekBar
            android:id="@+id/seekbar_red"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:max="255"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:progressTint="@android:color/holo_red_light"
            android:thumbTint="@android:color/holo_red_light" />

        <TextView
            android:id="@+id/value_red"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            android:gravity="end" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="G:"
            android:textColor="?attr/colorOnSurface"
            android:layout_gravity="center_vertical" />

        <SeekBar
            android:id="@+id/seekbar_green"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:max="255"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:progressTint="@android:color/holo_green_light"
            android:thumbTint="@android:color/holo_green_light" />

        <TextView
            android:id="@+id/value_green"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            android:gravity="end" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="B:"
            android:textColor="?attr/colorOnSurface"
            android:layout_gravity="center_vertical" />

        <SeekBar
            android:id="@+id/seekbar_blue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:max="255"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:progressTint="@android:color/holo_blue_light"
            android:thumbTint="@android:color/holo_blue_light" />

        <TextView
            android:id="@+id/value_blue"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            android:gravity="end" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:focusable="true"
            android:text="@string/cancel" />

        <Button
            android:id="@+id/btn_ok"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:layout_marginStart="8dp"
            android:focusable="true"
            android:text="@string/ok" />

    </LinearLayout>

</LinearLayout>
